
#include <iostream>
using namespace std;

int main() {
    int grade;
    int student = 1;
    int passed = 0;
    int failed = 0;

    while (student <= 10) {
        cout << "Enter grade of student " << student << ": ";
        cin >> grade;

        if (grade >= 75) {
            cout << "Result: PASSED" << endl;
            passed++;
        }
        else {
            cout << "Result: FAILED" << endl;
            failed++;
        }

        student++;
    }

    cout << "\n===== STUDENT PASSING COUNTER =====" << endl;
    cout << "Total Students: 10" << endl;
    cout << "Number of Passed Students: " << passed << endl;
    cout << "Number of Failed Students: " << failed << endl;

    return 0;
}
